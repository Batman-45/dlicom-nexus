# Dlicom Circle Environment Configuration
# Production on Vercel serves the Serverless API from the same origin (/api/...)
# Local development routes /api via Vite's dev proxy to localhost:3000

VITE_USE_MOCK_DATA=false

# Server-side Environment Variables (Vercel Project Settings / server/.env)
# NEVER prefix with VITE_ to prevent client bundle inclusion.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
