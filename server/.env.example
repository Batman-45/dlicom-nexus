# Dlicom Circle Backend Configuration
# No paid X API keys or Bearer Tokens required (uses official public X syndication engine)

PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,https://your-production-app.vercel.app

# Supabase Persistent Real-X Data Cache (Server-side ONLY - never expose to client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
